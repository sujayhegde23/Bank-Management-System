# ==============================================================================
# Bank Management System - Backend Environment Configuration (Template)
# ==============================================================================
# Copy this file to .env (or backend/.env) and configure your local settings.
# NEVER commit .env to version control!
# ==============================================================================

# Server Settings
PORT=5000
NODE_ENV=development

# MySQL Database Connection Settings (Primary Banking Operations)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=bank_management_system

# MongoDB Connection Settings (Fraud Detection System - Phase 1)
MONGODB_URI=mongodb://127.0.0.1:27017/bank_fraud_detection

# Fraud Detection Outbox Background Worker (Phase 3)
FRAUD_WORKER_ENABLED=true
FRAUD_WORKER_POLL_INTERVAL_MS=5000
FRAUD_WORKER_BATCH_SIZE=10
FRAUD_WORKER_LEASE_SECONDS=60
FRAUD_WORKER_MAX_ATTEMPTS=5

# CORS Allowed Origin (Frontend URL)
CLIENT_URL=http://localhost:5173

# Two-Factor Authentication (Email OTP) & SMTP Settings (Phase 2)
# Gmail SMTP configuration using STARTTLS (port 587) and Google App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ADMIN_OTP_EMAIL=admin@corebank.internal
OTP_HMAC_SECRET=replace_with_a_secure_hmac_secret_in_production


# Session Security & Cookie Configuration (Issue #5)
# In production, SESSION_SECRET MUST be set to a cryptographically secure random string.
# A development fallback is provided for local academic prototyping only.
SESSION_SECRET=replace_with_a_secure_random_key_in_production

# Session Inactivity Sliding Timeout in Minutes (Architecture §6.2: default is 15 minutes)
SESSION_MAX_AGE_MINUTES=15
