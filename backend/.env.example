# ==============================================================================
# Bank Management System - Backend Environment Configuration (Template)
# ==============================================================================
# Copy this file to .env (or backend/.env) and configure your local settings.
# NEVER commit .env to version control!
# ==============================================================================

# Server Settings
PORT=5000
NODE_ENV=development

# MySQL Database Connection Settings
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=bank_management_system

# CORS Allowed Origin (Frontend URL)
CLIENT_URL=http://localhost:5173

# Session Security & Cookie Configuration (Issue #5)
# In production, SESSION_SECRET MUST be set to a cryptographically secure random string.
# A development fallback is provided for local academic prototyping only.
SESSION_SECRET=replace_with_a_secure_random_key_in_production

# Session Inactivity Sliding Timeout in Minutes (Architecture §6.2: default is 15 minutes)
SESSION_MAX_AGE_MINUTES=15
