# ==============================================================================
# Bank Management System - Backend Environment Configuration (Template)
# ==============================================================================
# Copy this file to .env and configure your local settings.
# NEVER commit .env to version control!
# ==============================================================================

# Server Settings
PORT=5000
NODE_ENV=development

# MySQL Database Connection Settings
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=bank_management_system

# CORS Allowed Origin (Frontend URL)
CLIENT_URL=http://localhost:5173

# Security & Session Secret (Placeholder for future auth implementation)
SESSION_SECRET=replace_with_a_secure_random_key_in_development
