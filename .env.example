# ==============================================================================
# Bank Management System - Environment Variables (Example Template)
# ==============================================================================
# Copy this file to .env in backend/ or root and fill in your local values.
# NEVER commit the actual .env file or real credentials to version control.
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=bank_management_system

# Frontend / CORS Configuration
CLIENT_URL=http://localhost:5173

# Security & Session Configuration (Implementation Phase Placeholder)
SESSION_SECRET=replace_with_secure_random_secret_in_development
